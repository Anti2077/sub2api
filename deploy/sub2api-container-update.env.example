# Absolute directory containing the active Compose deployment.
COMPOSE_PROJECT_DIR=/opt/sub2api-deploy

# Paths are resolved relative to COMPOSE_PROJECT_DIR unless absolute.
COMPOSE_FILE=docker-compose.yml
COMPOSE_ENV_FILE=.env
COMPOSE_OVERRIDE_FILE=/etc/sub2api-container-update/docker-compose.auto-update.yml

# Only this service and this repository image are accepted by the updater.
SUB2API_SERVICE=sub2api
SUB2API_IMAGE=ghcr.io/anti2077/sub2api:custom
SUB2API_ROLLBACK_IMAGE=ghcr.io/anti2077/sub2api:rollback-local

# The replacement must become healthy within this window or it is rolled back.
HEALTH_TIMEOUT_SECONDS=180
HEALTH_POLL_INTERVAL_SECONDS=3
